        function renderResultsData() {
            const randomVar = Math.floor(Math.random() * 7) - 3;
            
            // Calibración precisa para A36 5G, Redmi Note 10s o modelos seleccionados
            let baseGen = 175;
            let baseRed = 146;
            let base2x = 165;
            let base4x = 148;

            if (generatorState.selectedDevice.toLowerCase().includes('note 10s')) {
                baseGen = 180; baseRed = 152; base2x = 170; base4x = 155;
            } else if (generatorState.selectedDevice.toLowerCase().includes('a36')) {
                baseGen = 172; baseRed = 145; base2x = 165; base4x = 148;
            } else if (generatorState.selectedDevice.toLowerCase().includes('iphone')) {
                baseGen = 165; baseRed = 138; base2x = 158; base4x = 142;
            }

            let gen = Math.min(200, Math.max(90, (generatorState.sensitivityStyle === 'Alta' ? baseGen : baseGen - 25) + randomVar));
            let red = Math.min(200, Math.max(80, (generatorState.sensitivityStyle === 'Alta' ? baseRed : baseRed - 20) + randomVar));
            let m2x = Math.min(200, Math.max(70, (generatorState.sensitivityStyle === 'Alta' ? base2x : base2x - 22) + randomVar));
            let m4x = Math.min(200, Math.max(65, (generatorState.sensitivityStyle === 'Alta' ? base4x : base4x - 18) + randomVar));

            let effectiveDpi = generatorState.dpiValue;
            if (generatorState.dpiMode === 'IA') {
                effectiveDpi = generatorState.selectedDevice.toLowerCase().includes('note 10s') ? 580 : 530;
            }

            let finalButtonText = generatorState.fireButtonSizeVal;
            if (generatorState.fireButtonMode === 'IA') {
                finalButtonText = generatorState.selectedDevice.toLowerCase().includes('note 10s') ? '44%' : '45%';
            } else {
                finalButtonText = generatorState.fireButtonSizeVal;
            }

            document.getElementById('resDeviceTitle').innerText = generatorState.selectedDevice.toUpperCase();
            document.getElementById('resTagOs').innerText = generatorState.selectedBrand.includes('Apple') ? 'iOS' : 'Android';
            document.getElementById('resTagStyle').innerText = `Rango ${generatorState.sensitivityStyle}`;
            document.getElementById('resTagButton').innerText = `Botón Calibrado`;
            document.getElementById('resDpiLabel').innerText = generatorState.selectedBrand.includes('Apple') ? 'Sensibilidad Táctil (iOS)' : 'DPI Experto (Android)';

            document.getElementById('resGeneral').innerText = gen;
            document.getElementById('barGeneral').style.width = `${(gen / 200) * 100}%`;

            document.getElementById('resRedDot').innerText = red;
            document.getElementById('barRedDot').style.width = `${(red / 200) * 100}%`;

            document.getElementById('res2X').innerText = m2x;
            document.getElementById('bar2X').style.width = `${(m2x / 200) * 100}%`;

            document.getElementById('res4X').innerText = m4x;
            document.getElementById('bar4X').style.width = `${(m4x / 200) * 100}%`;

            document.getElementById('resFireBtn').innerText = finalButtonText;
            document.getElementById('resDpiText').innerText = generatorState.dpiMode === 'Sin DPI' ? 'Off' : `${effectiveDpi}`;
            lucide.createIcons();
        }

        function copyConfiguration() {
            const textToCopy = `=== SOY LOGAN FF - CONFIGURACIÓN EXPERTA VIP ===\nDispositivo: ${generatorState.selectedDevice}\nGeneral: ${document.getElementById('resGeneral').innerText}\nPunto Rojo: ${document.getElementById('resRedDot').innerText}\nMira 2X: ${document.getElementById('res2X').innerText}\nMira 4X: ${document.getElementById('res4X').innerText}\nTamaño Botón: ${document.getElementById('resFireBtn').innerText}\nDPI: ${document.getElementById('resDpiText').innerText}\n===============================================`;
