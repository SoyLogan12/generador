        const canvas = document.getElementById('bgCanvas');
        const ctx = canvas.getContext('2d');
        let step = 0;
        function resizeCanvas() { canvas.width = window.innerWidth; canvas.height = window.innerHeight; }
        window.addEventListener('resize', resizeCanvas);
        resizeCanvas();

        function drawFluidWaves() {
            step += 0.006;
            const isDark = document.documentElement.classList.contains('dark');
            const height = canvas.height, width = canvas.width;
            ctx.clearRect(0, 0, width, height);
            ctx.beginPath();
            ctx.moveTo(0, height * 0.4);
            for (let x = 0; x <= width; x += 25) {
                const y = Math.sin(x * 0.003 + step) * 70 + Math.cos(x * 0.002 + step * 0.5) * 40 + height * 0.4;
                ctx.lineTo(x, y);
            }
            ctx.lineTo(width, height); ctx.lineTo(0, height); ctx.closePath();
            ctx.fillStyle = isDark ? 'rgba(128, 27, 34, 0.12)' : 'rgba(79, 70, 229, 0.04)';
            ctx.fill();
        }
        function animateCanvas() { drawFluidWaves(); requestAnimationFrame(animateCanvas); }
        animateCanvas();

        function toggleTheme() {
            const html = document.documentElement;
            if (html.classList.contains('dark')) {
                html.classList.remove('dark');
                localStorage.setItem('theme', 'light');
            } else {
                html.classList.add('dark');
                localStorage.setItem('theme', 'dark');
            }
            lucide.createIcons();
        }

        if (localStorage.getItem('theme') === 'dark') {
            document.documentElement.classList.add('dark');
        } else {
            document.documentElement.classList.remove('dark');
        }

