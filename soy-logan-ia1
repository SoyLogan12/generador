                    <span class="text-[10px] text-indigo-600 dark:text-amber-400 font-bold">Elegir</span>
                </div>
            `).join('');
            box.classList.remove('hidden');
        }

        function selectModel(modelName) {
            generatorState.selectedModel = modelName;
            generatorState.selectedDevice = `${generatorState.selectedBrand} ${modelName}`;
            document.getElementById('modelSearchInput').value = modelName;
            document.getElementById('modelSuggestionsBox').classList.add('hidden');
            document.getElementById('selectedDeviceLabel').innerText = generatorState.selectedDevice;
            document.getElementById('nextStep1Btn').classList.remove('opacity-50', 'pointer-events-none');
