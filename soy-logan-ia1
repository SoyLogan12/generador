                    <span id="statTotal" class="block font-heading text-4xl font-bold text-indigo-600 dark:text-indigo-400">0</span>
                    <span class="text-[10px] uppercase font-bold text-slate-500 dark:text-slate-400">Total Cuentas</span>
                </div>
                <div class="p-5 rounded-3xl bg-white dark:bg-[#120508] border border-slate-200 dark:border-rose-900/40 shadow-lg text-center">
                    <span id="statActive" class="block font-heading text-4xl font-bold text-emerald-600 dark:text-emerald-500">0</span>
                    <span class="text-[10px] uppercase font-bold text-slate-500 dark:text-slate-400">Activas VIP</span>
                </div>
                <div class="p-5 rounded-3xl bg-white dark:bg-[#120508] border border-slate-200 dark:border-rose-900/40 shadow-lg text-center">
                    <span id="statSuspended" class="block font-heading text-4xl font-bold text-amber-600 dark:text-amber-500">0</span>
                    <span class="text-[10px] uppercase font-bold text-slate-500 dark:text-slate-400">Suspendidas (Vencidas)</span>
                </div>
            </div>

            <!-- OTORGAR LICENCIA MANUAL -->
            <div class="p-6 rounded-3xl bg-white dark:bg-[#120508] border border-slate-200 dark:border-rose-900/40 shadow-xl space-y-4">
                <h3 class="font-heading text-2xl font-bold text-slate-900 dark:text-white flex items-center gap-2">
                    <i data-lucide="user-plus" class="w-5 h-5 text-amber-500"></i> Otorgar Licencia Manual
                </h3>
                <form onsubmit="addUser(event)" class="grid grid-cols-1 sm:grid-cols-5 gap-3">
                    <input type="text" id="newFfUser" placeholder="Nick de Free Fire" required class="px-4 py-3 text-xs rounded-xl border border-slate-300 dark:border-rose-900/40 bg-slate-50 dark:bg-[#0c0406] text-slate-900 dark:text-white">
                    <input type="email" id="newEmail" placeholder="Correo del cliente" required class="px-4 py-3 text-xs rounded-xl border border-slate-300 dark:border-rose-900/40 bg-slate-50 dark:bg-[#0c0406] text-slate-900 dark:text-white">
                    <input type="text" id="newPhone" placeholder="WhatsApp (Ej: 573001234567)" required class="px-4 py-3 text-xs rounded-xl border border-slate-300 dark:border-rose-900/40 bg-slate-50 dark:bg-[#0c0406] text-slate-900 dark:text-white">
                    <input type="text" id="newPass" placeholder="Contraseña" required class="px-4 py-3 text-xs rounded-xl border border-slate-300 dark:border-rose-900/40 bg-slate-50 dark:bg-[#0c0406] text-slate-900 dark:text-white">
                    <select id="newPlanDays" class="px-4 py-3 text-xs rounded-xl border border-slate-300 dark:border-rose-900/40 bg-slate-50 dark:bg-[#0c0406] text-slate-900 dark:text-white font-bold">
                        <option value="30">1 Mes / Principiante (30 Días)</option>
                        <option value="90">3 Meses / Pro Player (90 Días)</option>
                        <option value="365">1 Año / Profesional (365 Días)</option>
                    </select>
                    <button type="submit" class="sm:col-span-5 btn-3d-sweep py-3.5 rounded-xl bg-amber-500 text-slate-950 font-bold text-xs uppercase tracking-wider">
                        + Registrar y Activar Licencia VIP
                    </button>
                </form>
            </div>

            <!-- LISTADO DE CLIENTES CON FILTROS Y BÚSQUEDA -->
            <div class="p-6 rounded-3xl bg-white dark:bg-[#120508] border border-slate-200 dark:border-rose-900/40 shadow-xl space-y-4">
                <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
                    <h3 class="font-heading text-2xl font-bold text-slate-900 dark:text-white">Listado de Clientes & Cobros</h3>
                    
                    <div class="flex items-center gap-2 w-full sm:w-auto">
                        <div class="relative flex-grow sm:w-64">
                            <span class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400">
                                <i data-lucide="search" class="w-4 h-4"></i>
                            </span>
                            <input type="text" id="searchFilter" oninput="renderUsers()" placeholder="Buscar por correo, nick o tel..." class="w-full pl-9 pr-4 py-2 text-xs rounded-xl border border-slate-300 dark:border-rose-900/40 bg-slate-50 dark:bg-[#0c0406] text-slate-900 dark:text-white focus:outline-none">
                        </div>
                    </div>
                </div>

                <div id="usersList" class="space-y-3"></div>
            </div>

            <!-- AUDITORÍA Y LOGS -->
            <div class="p-6 rounded-3xl bg-white dark:bg-[#120508] border border-slate-200 dark:border-rose-900/40 shadow-xl space-y-3">
                <div class="flex items-center justify-between">
                    <h3 class="font-heading text-2xl font-bold text-slate-900 dark:text-white flex items-center gap-2">
                        <i data-lucide="activity" class="w-5 h-5 text-indigo-500"></i> Registro de Auditoría y Movimientos
                    </h3>
                    <button onclick="clearLogs()" class="text-[10px] text-slate-400 hover:text-rose-500 uppercase font-bold">Limpiar Logs</button>
                </div>
                <div id="auditLogs" class="max-h-40 overflow-y-auto space-y-2 text-[11px] text-slate-500 dark:text-slate-400 bg-slate-100 dark:bg-[#0c0406] p-4 rounded-2xl border border-slate-200 dark:border-rose-950/30"></div>
            </div>
        </main>
    </div>

    <!-- SCRIPTS -->
    <script>
        lucide.createIcons();

        const canvas = document.getElementById('bgCanvas');
        const ctx = canvas.getContext('2d');
        let step = 0;

        function resizeCanvas() {
            canvas.width = window.innerWidth;
            canvas.height = window.innerHeight;
        }
        window.addEventListener('resize', resizeCanvas);
        resizeCanvas();

        function drawFluidWaves() {
            step += 0.006;
            const isDark = document.documentElement.classList.contains('dark');
            const height = canvas.height;
            const width = canvas.width;

            ctx.beginPath();
            ctx.moveTo(0, height * 0.4);
            for (let x = 0; x <= width; x += 25) {
                const y = Math.sin(x * 0.003 + step) * 70 + Math.cos(x * 0.002 + step * 0.5) * 40 + height * 0.4;
                ctx.lineTo(x, y);
            }
            ctx.lineTo(width, height);
            ctx.lineTo(0, height);
            ctx.closePath();
            ctx.fillStyle = isDark ? 'rgba(128, 27, 34, 0.13)' : 'rgba(37, 99, 235, 0.07)';
            ctx.fill();

            ctx.beginPath();
            ctx.moveTo(0, height * 0.55);
            for (let x = 0; x <= width; x += 25) {
                const y = Math.cos(x * 0.004 - step * 1.1) * 80 + Math.sin(x * 0.0025 + step) * 50 + height * 0.55;
                ctx.lineTo(x, y);
            }
            ctx.lineTo(width, height);
            ctx.lineTo(0, height);
            ctx.closePath();
            ctx.fillStyle = isDark ? 'rgba(255, 183, 3, 0.06)' : 'rgba(79, 70, 229, 0.08)';
            ctx.fill();
        }

        function animateCanvas() {
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            drawFluidWaves();
            requestAnimationFrame(animateCanvas);
        }
        animateCanvas();

        function toggleTheme() {
            const html = document.documentElement;
            if (html.classList.contains('dark')) {
                html.classList.remove('dark');
                localStorage.setItem('theme', 'light');
            } else {
                html.classList.add('dark');
                localStorage.setItem('theme', 'dark');
            }
        }

        if (localStorage.getItem('theme') === 'dark') {
            document.documentElement.classList.add('dark');
        } else {
            document.documentElement.classList.remove('dark');
        }

        function scrollToPlans() {
            document.getElementById('plansSection').scrollIntoView({ behavior: 'smooth' });
        }

        const ADMIN_EMAIL = 'admin@soylogan.com';
        const ADMIN_PASS = 'admin123';

        let users = JSON.parse(localStorage.getItem('soylogan_users_v22')) || [
            { ffUser: 'LoganPro', email: 'vip@soylogan.com', phone: '573001112233', pass: '123', status: 'active', expiryDate: new Date(Date.now() + 365*24*60*60*1000).toISOString(), deviceId: null }
        ];

        let auditLogs = JSON.parse(localStorage.getItem('soylogan_logs_v22')) || [
            { text: 'Sistema configurado con acceso universal vip@soylogan.com / 123.', time: new Date().toLocaleTimeString() }
        ];

        function logAction(text) {
            const time = new Date().toLocaleTimeString();
            auditLogs.unshift({ text, time });
            if (auditLogs.length > 50) auditLogs.pop();
            localStorage.setItem('soylogan_logs_v22', JSON.stringify(auditLogs));
            renderLogs();
        }

        function renderLogs() {
            const container = document.getElementById('auditLogs');
            if (!container) return;
            container.innerHTML = auditLogs.map(l => `
                <div class="flex items-center justify-between border-b border-slate-200 dark:border-rose-950/30 pb-1">
                    <span>⚡ ${l.text}</span>
                    <span class="text-[9px] text-slate-400">${l.time}</span>
                </div>
            `).join('');
        }

        function clearLogs() {
            auditLogs = [];
            localStorage.removeItem('soylogan_logs_v22');
            renderLogs();
        }

        function saveUsers() {
            localStorage.setItem('soylogan_users_v22', JSON.stringify(users));
            renderUsers();
        }

        function openLoginModal() { 
            document.getElementById('mainContent').classList.add('hidden');
            document.getElementById('pageFooter').classList.add('hidden');
            document.getElementById('loginModal').classList.remove('hidden'); 
        }
        
        function closeLoginModal() { 
            document.getElementById('loginModal').classList.add('hidden'); 
            document.getElementById('mainContent').classList.remove('hidden');
            document.getElementById('pageFooter').classList.remove('hidden');
        }

        function openAdminView() {
            closeLoginModal();
            renderUsers();
            document.getElementById('adminView').classList.remove('hidden');
        }

        function closeAdminView() {
            document.getElementById('adminView').classList.add('hidden');
            document.getElementById('mainContent').classList.remove('hidden');
            document.getElementById('pageFooter').classList.remove('hidden');
        }

        function handleLogin(e) {
            e.preventDefault();
            const inputEmail = document.getElementById('loginEmail').value;
            const inputPass = document.getElementById('loginPassword').value;
            document.getElementById('deviceAlertMessage').classList.add('hidden');

            const email = inputEmail ? inputEmail.trim().toLowerCase() : '';
            const pass = inputPass ? inputPass.trim() : '';

            // Validación de Administrador
            if (email === ADMIN_EMAIL && pass === ADMIN_PASS) {
                openAdminView();
                return;
            }

            // REGLA ACTUALIZADA: Acceso universal con vip@soylogan.com y contraseña 123
            if (email === 'vip@soylogan.com' && pass === '123') {
                logAction(`Acceso universal concedido a cliente VIP.`);
                window.location.href = "generador.html";
                return;
            }

            // Sincronizar datos de la Oficina Virtual por si creaste accesos adicionales
            users = JSON.parse(localStorage.getItem('soylogan_users_v22')) || users;
            const user = users.find(u => {
                const storedEmail = u.email ? u.email.trim().toLowerCase() : '';
                const storedPass = u.pass ? u.pass.trim() : '';
                return storedEmail === email && storedPass === pass;
            });

            if (!user) { 
                alert('Correo o contraseña incorrectos.'); 
                return; 
            }
            
            if (user.status === 'active' && user.expiryDate && new Date() > new Date(user.expiryDate)) {
                user.status = 'suspended';
                saveUsers();
            }

            if (user.status === 'suspended') { 
                alert('Tu licencia ha expirado. Contacta a soporte para renovar.'); 
                return; 
            }

            window.location.href = "generador.html";
        }

        function renderUsers() {
            users = JSON.parse(localStorage.getItem('soylogan_users_v22')) || users;

            const list = document.getElementById('usersList');
            if(!list) return;

            const searchFilter = document.getElementById('searchFilter').value.toLowerCase();

            document.getElementById('statTotal').innerText = users.length;
            document.getElementById('statActive').innerText = users.filter(u => u.status === 'active').length;
            document.getElementById('statSuspended').innerText = users.filter(u => u.status === 'suspended').length;

            const filtered = users.filter(u => {
                return (u.email && u.email.toLowerCase().includes(searchFilter)) || 
                       (u.ffUser && u.ffUser.toLowerCase().includes(searchFilter)) || 
                       (u.phone && u.phone.includes(searchFilter));
            });

            if (filtered.length === 0) {
                list.innerHTML = `<p class="text-xs text-center text-slate-400 py-6">No se encontraron clientes con esos filtros.</p>`;
                return;
            }

            list.innerHTML = filtered.map(u => {
                const index = users.findIndex(orig => orig.email === u.email);
                const expiryFormatted = u.expiryDate ? new Date(u.expiryDate).toLocaleDateString() : 'N/A';
                
                let whatsappBtn = '';
                if(u.phone) {
                    let msg = `¡Hola ${u.ffUser || 'Gamer'}! Ya puedes ingresar al generador de SOY LOGAN FF usando el correo: vip@soylogan.com y contraseña: 123`;
                    whatsappBtn = `<a href="https://wa.me/${u.phone.replace('+','')}?text=${encodeURIComponent(msg)}" target="_blank" class="px-3 py-1.5 rounded-xl bg-emerald-600 text-white text-[10px] font-bold flex items-center gap-1">💬 WhatsApp</a>`;
                }

                return `
                    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between p-4 rounded-2xl border border-slate-200 dark:border-rose-900/30 bg-slate-50 dark:bg-[#0c0406] gap-3">
                        <div class="space-y-1">
                            <div class="text-xs font-bold text-slate-900 dark:text-white flex items-center gap-2 flex-wrap">
                                <span>${u.email}</span>
                                <span class="text-[9px] px-2 py-0.5 rounded-full bg-emerald-500/20 text-emerald-400">ACTIVO VIP</span>
                            </div>
                            <div class="text-[11px] text-slate-500 dark:text-slate-400 flex gap-4 flex-wrap items-center">
                                <span>Nick: <strong class="text-indigo-600 dark:text-indigo-400">${u.ffUser || 'N/A'}</strong></span>
                                <span>Pass: <strong class="text-indigo-600 dark:text-indigo-400">${u.pass}</strong></span>
                                <span>Tel: <strong class="text-slate-700 dark:text-slate-300">${u.phone || 'N/A'}</strong></span>
                                <span>Vence: <strong class="text-amber-600 dark:text-amber-400">${expiryFormatted}</strong></span>
                            </div>
                        </div>
                        <div class="flex items-center space-x-2 w-full sm:w-auto justify-end flex-wrap gap-2">
                            ${whatsappBtn}
                            <button onclick="extendTime(${index}, 30)" title="Extender 30 días" class="px-2.5 py-1.5 rounded-xl bg-indigo-500/20 text-indigo-600 dark:text-indigo-400 text-[10px] font-bold">+30D</button>
                            <button onclick="deleteUser(${index})" class="p-1.5 rounded-xl bg-rose-500/10 text-rose-500"><i data-lucide="trash-2" class="w-4 h-4"></i></button>
                        </div>
                    </div>
                `;
            }).join('');
            lucide.createIcons();
        }

        function addUser(e) {
            e.preventDefault();
            const ffUser = document.getElementById('newFfUser').value.trim();
            const email = document.getElementById('newEmail').value.trim().toLowerCase();
            const phone = document.getElementById('newPhone').value.trim();
            const pass = document.getElementById('newPass').value.trim();
            const days = parseInt(document.getElementById('newPlanDays').value);
            
            users = JSON.parse(localStorage.getItem('soylogan_users_v22')) || users;
            users.push({ ffUser, email, phone: phone.startsWith('+') ? phone : '+57' + phone, pass, status: 'active', expiryDate: new Date(Date.now() + days * 24 * 60 * 60 * 1000).toISOString(), deviceId: null });
            saveUsers();
            logAction(`Licencia manual creada para ${email} (${days} días).`);
            
            document.getElementById('newFfUser').value = '';
            document.getElementById('newEmail').value = '';
            document.getElementById('newPhone').value = '';
            document.getElementById('newPass').value = '';
            alert('¡Licencia VIP creada exitosamente!');
        }

        function extendTime(index, days) {
            users = JSON.parse(localStorage.getItem('soylogan_users_v22')) || users;
            const currentExpiry = new Date(users[index].expiryDate > Date.now() ? users[index].expiryDate : Date.now());
            users[index].expiryDate = new Date(currentExpiry.getTime() + days * 24 * 60 * 60 * 1000).toISOString();
            users[index].status = 'active';
            saveUsers();
            logAction(`Se extendió la membresía de ${users[index].email} por ${days} días.`);
            alert(`¡Membresía extendida ${days} días con éxito!`);
        }

        function deleteUser(index) {
            users = JSON.parse(localStorage.getItem('soylogan_users_v22')) || users;
            if(confirm('¿Eliminar definitivamente este usuario?')) {
                logAction(`Cliente ${users[index].email} eliminado del sistema.`);
                users.splice(index, 1);
                saveUsers();
            }
        }

        function exportDataBackup() {
            const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify({ users, auditLogs }, null, 2));
            const downloadAnchor = document.createElement('a');
            downloadAnchor.setAttribute("href", dataStr);
            downloadAnchor.setAttribute("download", `soylogan_respaldo_${new Date().toISOString().slice(0,10)}.json`);
            document.body.appendChild(downloadAnchor);
            downloadAnchor.click();
            downloadAnchor.remove();
            logAction('Respaldo de base de datos exportado.');
        }

        renderUsers();
        renderLogs();
    </script>
</body>
