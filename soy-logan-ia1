    <!-- OFICINA VIRTUAL ADMIN PROFESIONAL Y AUTOMATIZADA -->
    <div id="adminView" class="fixed inset-0 bg-slate-50 dark:bg-[#060103] z-50 flex flex-col hidden animate-site-entrance overflow-y-auto">
        <header class="bg-white/95 dark:bg-[#120508]/95 backdrop-blur-xl border-b border-slate-200 dark:border-rose-950/40 px-6 py-4 flex items-center justify-between sticky top-0 z-20 shadow-md">
            <div class="flex items-center space-x-3">
                <div class="p-2.5 rounded-2xl bg-amber-500/10 border border-amber-500/30 text-amber-500">
                    <i data-lucide="shield-check" class="w-6 h-6"></i>
                </div>
                <div>
                    <h2 class="font-heading text-3xl font-bold text-slate-900 dark:text-white leading-none">Oficina Virtual Admin</h2>
                    <p class="text-[11px] text-slate-500 dark:text-slate-400">Control total Luciana Curvelo</p>
                </div>
            </div>
            <div class="flex items-center gap-3">
                <button onclick="exportDataBackup()" class="btn-3d-sweep px-4 py-2.5 rounded-xl bg-slate-200 dark:bg-rose-950/60 text-slate-700 dark:text-amber-400 font-bold text-xs uppercase flex items-center gap-2">
                    <i data-lucide="download" class="w-4 h-4"></i>
                    <span>Respaldar BD</span>
