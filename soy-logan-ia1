                        <input type="password" id="loginPassword" required autocapitalize="none" autocorrect="off" spellcheck="false" autocomplete="current-password" placeholder="••••••••" class="w-full px-4 py-3 rounded-xl border border-slate-300 dark:border-rose-900/50 bg-slate-50 dark:bg-[#0c0406] text-slate-900 dark:text-white focus:ring-2 focus:ring-indigo-500 dark:focus:ring-amber-500 focus:outline-none text-sm transition-all">
