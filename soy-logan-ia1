<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SOY LOGAN FF — Generador IA de Sensibilidad VIP</title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Teko:wght@500;600;700&display=swap" rel="stylesheet">
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>

    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        heading: ['Teko', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    
    <style>
        * { -webkit-tap-highlight-color: transparent; }
        body { font-family: 'Inter', sans-serif; transition: background-color 0.4s ease, color 0.4s ease; }
        h1, h2, h3, h4, .font-heading {
            font-family: 'Teko', sans-serif;
            font-weight: 700;
            letter-spacing: 0.05em;
            text-transform: uppercase;
            line-height: 0.95;
        }
        .smooth-hardware {
            will-change: transform, opacity;
            backface-visibility: hidden;
            transform: translate3d(0, 0, 0);
        }
        @keyframes cleanEntrance {
            0% { opacity: 0; transform: translateY(10px); }
            100% { opacity: 1; transform: translateY(0); }
        }
        .animate-site-entrance { animation: cleanEntrance 0.5s cubic-bezier(0.16, 1, 0.3, 1) forwards; }
        
        .btn-3d-sweep {
            position: relative;
            overflow: hidden !important;
            border: 1px solid rgba(255, 255, 255, 0.25);
            box-shadow: 0 8px 20px -4px rgba(0, 0, 0, 0.3), inset 0 1px 0 rgba(255, 255, 255, 0.3);
            transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .btn-3d-sweep:hover {
            transform: translateY(-2px) scale(1.02);
            box-shadow: 0 14px 28px -4px rgba(79, 70, 229, 0.3);
        }
        .dark .btn-3d-sweep:hover {
            box-shadow: 0 14px 28px -4px rgba(245, 158, 11, 0.4);
        }

        .step-card-select {
            transition: all 0.25s ease;
        }
        .light .step-card-select, :root:not(.dark) .step-card-select {
            border: 2px solid rgba(79, 70, 229, 0.2);
            background: rgba(255, 255, 255, 0.9);
        }
        .light .step-card-select:hover, .light .step-card-select.selected, :root:not(.dark) .step-card-select:hover, :root:not(.dark) .step-card-select.selected {
            border-color: #4f46e5;
            background: rgba(79, 70, 229, 0.08);
            transform: translateY(-2px);
        }
        .dark .step-card-select {
            border: 2px solid rgba(245, 158, 11, 0.2);
            background: #0c0406;
        }
        .dark .step-card-select:hover, .dark .step-card-select.selected {
            border-color: #f59e0b;
            background: rgba(245, 158, 11, 0.08);
            transform: translateY(-2px);
        }
    </style>
</head>
<body class="bg-slate-100 text-slate-900 dark:bg-[#060103] dark:text-slate-100 min-h-screen flex flex-col justify-between selection:bg-indigo-500 selection:text-white dark:selection:bg-amber-500 dark:selection:text-black relative overflow-x-hidden animate-site-entrance">

    <!-- CANVAS DE FONDO ONDULANTE -->
    <canvas id="bgCanvas" class="fixed inset-0 pointer-events-none z-0 opacity-60 dark:opacity-75"></canvas>

    <!-- NAVBAR SUPERIOR -->
    <header class="sticky top-0 z-40 bg-white/85 dark:bg-[#0f0407]/85 backdrop-blur-xl border-b border-slate-200 dark:border-rose-950/30">
        <div class="max-w-4xl mx-auto px-4 h-20 flex items-center justify-between">
            <div class="flex flex-col justify-center">
                <span class="font-heading font-bold text-4xl tracking-wide text-slate-900 dark:text-white leading-none">
                    SOY LOGAN <span class="text-indigo-600 dark:text-amber-500 font-semibold text-2xl">FF</span>
                </span>
                <span class="text-[10px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-[0.3em] mt-0.5">GENERADOR IA DE SENSIBILIDAD</span>
            </div>
            
            <div class="flex items-center space-x-3">
                <button id="themeToggle" onclick="toggleTheme()" class="btn-3d-sweep p-2.5 rounded-xl bg-slate-200 dark:bg-rose-950/30 text-slate-700 dark:text-amber-400" title="Cambiar Modo">
                    <i data-lucide="sun" id="sunIcon" class="w-4 h-4 hidden dark:block"></i>
                    <i data-lucide="moon" id="moonIcon" class="w-4 h-4 block dark:hidden"></i>
                </button>
                <span class="px-3 py-1 rounded-full bg-indigo-500/10 dark:bg-amber-500/10 border border-indigo-500/30 dark:border-amber-500/30 text-indigo-600 dark:text-amber-400 text-xs font-bold flex items-center gap-1.5">
                    <i data-lucide="shield-check" class="w-3.5 h-3.5"></i> VIP Calibrado
                </span>
            </div>
        </div>
    </header>

    <!-- CONTENIDO PRINCIPAL: WIDGET DE 4 PASOS -->
    <main class="flex-grow z-10 relative max-w-2xl mx-auto px-4 py-10 w-full flex items-center justify-center">
        
        <div class="w-full bg-white dark:bg-[#140608]/90 backdrop-blur-xl border border-slate-200 dark:border-rose-900/40 rounded-3xl p-6 sm:p-8 shadow-2xl relative">
            
            <!-- BARRA DE PROGRESO -->
            <div class="mb-8">
                <div class="flex justify-between items-center mb-2">
                    <span id="stepIndicatorLabel" class="text-xs font-bold uppercase tracking-widest text-indigo-600 dark:text-amber-400">Paso 1 de 4</span>
                    <span id="stepPercentage" class="text-xs font-bold text-slate-400">25%</span>
                </div>
                <div class="w-full h-2 bg-slate-200 dark:bg-rose-950/50 rounded-full overflow-hidden">
                    <div id="progressBar" class="h-full bg-gradient-to-r from-indigo-600 to-indigo-500 dark:from-amber-600 dark:to-amber-400 transition-all duration-300" style="width: 25%;"></div>
                </div>
            </div>

            <!-- ================= PASO 1: BUSCADORES PREDICTIVOS DE MARCA Y MODELO ================= -->
            <div id="step1" class="space-y-6 animate-site-entrance">
                <div class="text-center space-y-1">
                    <h2 class="font-heading text-4xl sm:text-5xl font-bold text-slate-900 dark:text-white">Busca tu Dispositivo</h2>
                    <p class="text-xs text-slate-500 dark:text-slate-400">Miles de modelos cargados: iPhone, Samsung (incl. A36 5G), Xiaomi (incl. Redmi Note 10s) y más.</p>
                </div>

                <div class="space-y-4 max-w-md mx-auto">
                    
                    <!-- 1. BUSCADOR PREDICTIVO DE MARCA -->
                    <div class="relative">
                        <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-2 uppercase tracking-wider">1. Escribe la Marca (Ej: Samsung, Apple, Xiaomi...)</label>
                        <div class="relative">
                            <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                                <i data-lucide="tag" class="w-4 h-4"></i>
                            </span>
                            <input type="text" id="brandSearchInput" placeholder="Ej: Apple, Samsung, Xiaomi..." oninput="filterBrandSuggestions(this.value)" autocomplete="off" class="w-full pl-10 pr-4 py-3 rounded-xl border border-slate-300 dark:border-rose-900/50 bg-slate-50 dark:bg-[#0c0406] text-slate-900 dark:text-white text-sm focus:ring-2 focus:ring-indigo-500 dark:focus:ring-amber-500 focus:outline-none">
                        </div>
                        <div id="brandSuggestionsBox" class="absolute left-0 right-0 mt-1 bg-white dark:bg-[#1a070a] border border-slate-200 dark:border-rose-900/50 rounded-2xl shadow-2xl max-h-48 overflow-y-auto z-30 hidden"></div>
                    </div>

                    <!-- 2. BUSCADOR PREDICTIVO DE MODELO EXACTO -->
                    <div class="relative">
                        <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-2 uppercase tracking-wider">2. Escribe el Modelo Exacto (Ej: A36 5G, Note 10s, 16 Pro...)</label>
                        <div class="relative">
                            <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                                <i data-lucide="smartphone" class="w-4 h-4"></i>
                            </span>
                            <input type="text" id="modelSearchInput" placeholder="Primero selecciona o escribe una marca..." oninput="filterModelSuggestions(this.value)" autocomplete="off" class="w-full pl-10 pr-4 py-3 rounded-xl border border-slate-300 dark:border-rose-900/50 bg-slate-50 dark:bg-[#0c0406] text-slate-900 dark:text-white text-sm focus:ring-2 focus:ring-indigo-500 dark:focus:ring-amber-500 focus:outline-none" disabled>
                        </div>
                        <div id="modelSuggestionsBox" class="absolute left-0 right-0 mt-1 bg-white dark:bg-[#1a070a] border border-slate-200 dark:border-rose-900/50 rounded-2xl shadow-2xl max-h-56 overflow-y-auto z-30 hidden"></div>
                    </div>

                    <!-- DISPOSITIVO SELECCIONADO -->
                    <div class="p-4 rounded-2xl bg-indigo-50 dark:bg-rose-950/20 border border-indigo-100 dark:border-rose-900/30 flex items-center gap-3 mt-2">
                        <div class="p-2 rounded-xl bg-indigo-500/10 dark:bg-amber-500/10 text-indigo-600 dark:text-amber-400">
                            <i data-lucide="check-circle-2" class="w-5 h-5"></i>
                        </div>
                        <div>
                            <span class="text-[10px] text-slate-500 dark:text-slate-400 uppercase font-bold block">Seleccionado oficialmente:</span>
                            <strong id="selectedDeviceLabel" class="text-xs font-bold text-indigo-700 dark:text-amber-300">Ningún dispositivo seleccionado</strong>
                        </div>
                    </div>
                </div>

                <div class="pt-4 flex justify-end">
                    <button id="nextStep1Btn" onclick="nextStep(2)" class="btn-3d-sweep px-8 py-3.5 rounded-xl bg-gradient-to-r from-indigo-600 to-indigo-700 dark:from-amber-500 dark:to-amber-600 text-white dark:text-slate-950 font-bold text-xs uppercase tracking-wider flex items-center gap-2 opacity-50 pointer-events-none">
                        <span>Siguiente</span>
                        <i data-lucide="arrow-right" class="w-4 h-4"></i>
                    </button>
                </div>
            </div>

            <!-- ================= PASO 2: ESTILO DE SENSIBILIDAD ================= -->
            <div id="step2" class="space-y-6 hidden animate-site-entrance">
                <div class="text-center space-y-1">
                    <h2 class="font-heading text-4xl sm:text-5xl font-bold text-slate-900 dark:text-white">¿Cómo quieres la sensi?</h2>
                    <p class="text-xs text-slate-500 dark:text-slate-400">Define la velocidad de giro y respuesta para tus movimientos.</p>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 max-w-md mx-auto">
                    <div onclick="selectSensitivityStyle('Alta', this)" class="step-card-select p-4 rounded-2xl text-center cursor-pointer selected">
                        <i data-lucide="zap" class="w-7 h-7 text-indigo-600 dark:text-amber-400 mx-auto mb-1"></i>
                        <h4 class="font-heading text-2xl font-bold text-slate-900 dark:text-white">Alta</h4>
                        <p class="text-[10px] text-slate-500 dark:text-slate-400 mt-1">Máxima velocidad de giro y levantamiento rápido.</p>
                    </div>
                    <div onclick="selectSensitivityStyle('Media', this)" class="step-card-select p-4 rounded-2xl text-center cursor-pointer">
                        <i data-lucide="sliders" class="w-7 h-7 text-indigo-600 dark:text-amber-400 mx-auto mb-1"></i>
                        <h4 class="font-heading text-2xl font-bold text-slate-900 dark:text-white">Media</h4>
                        <p class="text-[10px] text-slate-500 dark:text-slate-400 mt-1">Equilibrio perfecto entre velocidad y estabilidad.</p>
                    </div>
                    <div onclick="selectSensitivityStyle('Baja', this)" class="step-card-select p-4 rounded-2xl text-center cursor-pointer">
                        <i data-lucide="shield" class="w-7 h-7 text-indigo-600 dark:text-amber-400 mx-auto mb-1"></i>
                        <h4 class="font-heading text-2xl font-bold text-slate-900 dark:text-white">Baja</h4>
                        <p class="text-[10px] text-slate-500 dark:text-slate-400 mt-1">Mayor precisión a distancia y control de mira.</p>
                    </div>
                </div>

                <div class="pt-4 flex justify-between">
                    <button onclick="prevStep(1)" class="btn-3d-sweep px-6 py-3 rounded-xl bg-slate-200 dark:bg-rose-950/40 text-slate-700 dark:text-slate-300 font-bold text-xs uppercase">Anterior</button>
                    <button onclick="nextStep(3)" class="btn-3d-sweep px-8 py-3 rounded-xl bg-gradient-to-r from-indigo-600 to-indigo-700 dark:from-amber-500 dark:to-amber-600 text-white dark:text-slate-950 font-bold text-xs uppercase flex items-center gap-2">
                        <span>Siguiente</span>
                        <i data-lucide="arrow-right" class="w-4 h-4"></i>
                    </button>
                </div>
            </div>

            <!-- ================= PASO 3: DPI AUTOMÁTICO IA O MANUAL ================= -->
            <div id="step3" class="space-y-6 hidden animate-site-entrance">
                <div class="text-center space-y-1">
                    <h2 class="font-heading text-4xl sm:text-5xl font-bold text-slate-900 dark:text-white">Configuración de DPI</h2>
                    <p class="text-xs text-slate-500 dark:text-slate-400">Deja que la IA calcule el DPI ideal o ajústalo de forma manual.</p>
                </div>

                <div class="max-w-md mx-auto space-y-3">
                    <div onclick="selectDpiMode('IA', 530, this)" id="aiDpiCard" class="step-card-select p-4 rounded-2xl bg-gradient-to-r from-indigo-500/10 to-amber-500/10 border-2 border-indigo-500 dark:border-amber-500 text-center cursor-pointer selected shadow-md">
                        <div class="flex items-center justify-center gap-2 text-indigo-600 dark:text-amber-400 mb-1">
                            <i data-lucide="sparkles" class="w-5 h-5 animate-pulse"></i>
                            <span class="font-heading text-xl font-bold uppercase tracking-wider">Dejar que la IA elija el DPI recomendado</span>
                        </div>
                        <p class="text-[11px] text-slate-600 dark:text-slate-300">Calibración automática experta según el procesador de tu dispositivo.</p>
                    </div>

                    <div class="text-center text-[10px] font-bold text-slate-400 uppercase tracking-widest my-1">— O ajusta manualmente —</div>

                    <div class="grid grid-cols-2 gap-3">
                        <div onclick="selectDpiMode('Manual', 480, this)" class="step-card-select p-3.5 rounded-2xl text-center cursor-pointer">
                            <span class="font-heading text-xl font-bold text-slate-900 dark:text-white block">DPI Manual</span>
                            <span class="text-[10px] text-slate-500">Con Slider Personalizado</span>
                        </div>
                        <div onclick="selectDpiMode('Sin DPI', 0, this)" class="step-card-select p-3.5 rounded-2xl text-center cursor-pointer">
                            <span class="font-heading text-xl font-bold text-slate-900 dark:text-white block">Sin DPI</span>
                            <span class="text-[10px] text-slate-500">Original de Fábrica</span>
                        </div>
                    </div>

                    <div id="dpiSliderContainer" class="p-4 rounded-2xl bg-slate-50 dark:bg-[#0c0406] border border-slate-200 dark:border-rose-900/30 space-y-3 hidden">
                        <div class="flex justify-between items-center">
                            <label class="text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider">DPI Personalizado</label>
                            <span id="dpiValueDisplay" class="font-heading text-2xl font-bold text-indigo-600 dark:text-amber-400">530</span>
                        </div>
                        <input type="range" id="dpiRange" min="360" max="720" value="530" step="1" oninput="updateDpiDisplay(this.value)" class="w-full accent-indigo-600 dark:accent-amber-500 cursor-pointer">
                        <div class="flex justify-between text-[10px] text-slate-500 font-bold">
                            <span>360</span>
                            <span>530</span>
                            <span>720</span>
                        </div>
                    </div>
                </div>

                <div class="pt-4 flex justify-between">
                    <button onclick="prevStep(2)" class="btn-3d-sweep px-6 py-3 rounded-xl bg-slate-200 dark:bg-rose-950/40 text-slate-700 dark:text-slate-300 font-bold text-xs uppercase">Anterior</button>
                    <button onclick="nextStep(4)" class="btn-3d-sweep px-8 py-3 rounded-xl bg-gradient-to-r from-indigo-600 to-indigo-700 dark:from-amber-500 dark:to-amber-600 text-white dark:text-slate-950 font-bold text-xs uppercase flex items-center gap-2">
                        <span>Siguiente</span>
                        <i data-lucide="arrow-right" class="w-4 h-4"></i>
                    </button>
                </div>
            </div>

            <!-- ================= PASO 4: TAMAÑO DE BOTÓN DE DISPARO ================= -->
            <div id="step4" class="space-y-6 hidden animate-site-entrance">
                <div class="text-center space-y-1">
                    <h2 class="font-heading text-4xl sm:text-5xl font-bold text-slate-900 dark:text-white">Tamaño del botón de disparo</h2>
                    <p class="text-xs text-slate-500 dark:text-slate-400">Elige manual o deja que la Inteligencia Artificial lo calibre por ti.</p>
                </div>

                <div class="max-w-md mx-auto space-y-3">
                    <div onclick="selectFireButtonSize('IA', 'Automático IA', this)" id="aiButtonCard" class="step-card-select p-4 rounded-2xl bg-gradient-to-r from-indigo-500/10 to-amber-500/10 border-2 border-indigo-500 dark:border-amber-500 text-center cursor-pointer selected shadow-md">
                        <div class="flex items-center justify-center gap-2 text-indigo-600 dark:text-amber-400 mb-1">
                            <i data-lucide="sparkles" class="w-5 h-5 animate-pulse"></i>
                            <span class="font-heading text-xl font-bold uppercase tracking-wider">Dejar que la IA elija el tamaño recomendado</span>
                        </div>
                        <p class="text-[11px] text-slate-600 dark:text-slate-300">Calcula el porcentaje perfecto basado en tu dispositivo y DPI.</p>
                    </div>

                    <div class="text-center text-[10px] font-bold text-slate-400 uppercase tracking-widest my-1">— O selecciona manualmente —</div>

                    <div class="grid grid-cols-3 gap-2">
                        <div onclick="selectFireButtonSize('Pequeño', '42%', this)" class="step-card-select p-3 rounded-2xl text-center cursor-pointer">
                            <span class="font-heading text-xl font-bold text-indigo-600 dark:text-amber-400 block">40% - 44%</span>
                            <span class="text-[11px] font-bold text-slate-700 dark:text-white">Pequeño</span>
                        </div>
                        <div onclick="selectFireButtonSize('Mediano', '48%', this)" class="step-card-select p-3 rounded-2xl text-center cursor-pointer">
                            <span class="font-heading text-xl font-bold text-indigo-600 dark:text-amber-400 block">46% - 50%</span>
                            <span class="text-[11px] font-bold text-slate-700 dark:text-white">Mediano</span>
                        </div>
                        <div onclick="selectFireButtonSize('Grande', '56%', this)" class="step-card-select p-3 rounded-2xl text-center cursor-pointer">
                            <span class="font-heading text-xl font-bold text-indigo-600 dark:text-amber-400 block">54% - 58%</span>
                            <span class="text-[11px] font-bold text-slate-700 dark:text-white">Grande</span>
                        </div>
                    </div>
                </div>

                <div class="pt-4 flex justify-between">
                    <button onclick="prevStep(3)" class="btn-3d-sweep px-6 py-3 rounded-xl bg-slate-200 dark:bg-rose-950/40 text-slate-700 dark:text-slate-300 font-bold text-xs uppercase">Anterior</button>
                    <button onclick="generateFinalSensitivity()" class="btn-3d-sweep px-8 py-3.5 rounded-xl bg-gradient-to-r from-indigo-600 via-indigo-700 to-amber-500 dark:from-amber-400 dark:to-amber-600 text-white dark:text-slate-950 font-extrabold text-xs uppercase tracking-wider flex items-center gap-2 shadow-lg">
                        <i data-lucide="cpu" class="w-4 h-4"></i>
                        <span>Generar Configuración IA</span>
                    </button>
                </div>
            </div>

            <!-- ================= PANTALLA DE CARGA ================= -->
            <div id="loadingView" class="py-12 text-center space-y-6 hidden animate-site-entrance">
                <div class="relative w-20 h-20 mx-auto flex items-center justify-center">
                    <div class="absolute inset-0 rounded-full border-2 border-indigo-500/20 dark:border-amber-500/20 border-t-indigo-600 dark:border-t-amber-500 animate-spin"></div>
                    <i data-lucide="cpu" class="w-8 h-8 text-indigo-600 dark:text-amber-400 animate-pulse"></i>
                </div>
                <div class="space-y-1">
                    <h3 id="loadingStatusText" class="font-heading text-3xl font-bold text-slate-900 dark:text-white uppercase tracking-wider">Calibrando aceleración experta...</h3>
                    <p class="text-xs text-indigo-600 dark:text-amber-400 font-mono">Sincronizando perfiles de modelos...</p>
                </div>
            </div>

            <!-- ================= PANTALLA DE RESULTADOS (TARJETA ÉLITE) ================= -->
            <div id="resultsView" class="space-y-6 hidden animate-site-entrance">
                
                <div class="bg-gradient-to-b from-[#111936] to-[#0a0d1a] border border-indigo-500/40 rounded-3xl p-5 sm:p-6 text-white shadow-2xl relative overflow-hidden">
                    
                    <div class="flex items-start justify-between border-b border-indigo-900/50 pb-4 mb-4">
                        <div>
                            <div class="flex items-center gap-1.5 text-[10px] font-bold text-indigo-400 tracking-widest uppercase mb-1">
                                <span class="w-2 h-2 rounded-full bg-cyan-400 animate-ping"></span>
                                Configuración Élite Calibrada
                            </div>
                            <h3 id="resDeviceTitle" class="font-heading text-3xl sm:text-4xl font-bold tracking-wide text-white">SAMSUNG GALAXY A36 5G</h3>
                            
                            <div class="flex flex-wrap items-center gap-2 mt-2">
                                <span id="resTagOs" class="px-2.5 py-0.5 rounded-full bg-indigo-950/80 border border-indigo-700/50 text-[10px] font-bold text-indigo-200 uppercase">Android</span>
                                <span id="resTagStyle" class="px-2.5 py-0.5 rounded-full bg-indigo-950/80 border border-indigo-700/50 text-[10px] font-bold text-indigo-200 uppercase">Rango Alta</span>
                                <span id="resTagButton" class="px-2.5 py-0.5 rounded-full bg-indigo-950/80 border border-indigo-700/50 text-[10px] font-bold text-indigo-200 uppercase">Botón Experto</span>
                                <span class="px-2.5 py-0.5 rounded-full bg-cyan-950/80 border border-cyan-700/50 text-[10px] font-bold text-cyan-300 uppercase flex items-center gap-1">
                                    <i data-lucide="check" class="w-3 h-3"></i> 100% Funcional
                                </span>
                            </div>
                        </div>
                        <button onclick="resetGenerator()" class="p-2 rounded-full bg-white/10 hover:bg-white/20 text-slate-300 transition-colors" title="Cerrar / Cambiar">
                            <i data-lucide="x" class="w-5 h-5"></i>
                        </button>
                    </div>

                    <div class="space-y-4">
                        <div>
                            <div class="flex justify-between items-center mb-1 text-xs">
                                <span class="font-bold text-slate-300 flex items-center gap-1.5 uppercase tracking-wider text-[11px]">
