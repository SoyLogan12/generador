            selectedBrand: '',
            selectedModel: '',
            selectedDevice: '',
            sensitivityStyle: 'Alta',
            dpiMode: 'IA',
            dpiValue: 530,
            fireButtonMode: 'IA',
            fireButtonSizeVal: '45%'
        };

        function filterBrandSuggestions(query) {
            const box = document.getElementById('brandSuggestionsBox');
            const q = query.trim().toLowerCase();
            if (q.length === 0) { box.classList.add('hidden'); return; }

            const filtered = brandsList.filter(b => b.toLowerCase().includes(q));
            if (filtered.length === 0) {
                box.innerHTML = `<div class="p-3 text-xs text-slate-400 text-center">Marca no encontrada</div>`;
                box.classList.remove('hidden');
                return;
            }

            box.innerHTML = filtered.map(b => `
                <div onclick="selectBrand('${b}')" class="px-4 py-2.5 text-xs font-semibold text-slate-800 dark:text-slate-200 hover:bg-indigo-50 dark:hover:bg-rose-950/40 cursor-pointer border-b border-slate-100 dark:border-rose-950/20 flex items-center justify-between">
                    <span>🏷️ ${b}</span>
                    <span class="text-[10px] text-indigo-600 dark:text-amber-400 font-bold">Seleccionar</span>
                </div>
            `).join('');
            box.classList.remove('hidden');
        }

        function selectBrand(brand) {
            generatorState.selectedBrand = brand;
            document.getElementById('brandSearchInput').value = brand;
            document.getElementById('brandSuggestionsBox').classList.add('hidden');

            const modelInput = document.getElementById('modelSearchInput');
            modelInput.disabled = false;
            modelInput.value = '';
            modelInput.placeholder = `Escribe modelo de ${brand} (Ej: A36 5G, Note 10s...)`;
            modelInput.focus();

            generatorState.selectedModel = '';
            generatorState.selectedDevice = '';
            document.getElementById('selectedDeviceLabel').innerText = `Marca seleccionada: ${brand}. Falta modelo.`;
            document.getElementById('nextStep1Btn').classList.add('opacity-50', 'pointer-events-none');
        }

        function filterModelSuggestions(query) {
            const box = document.getElementById('modelSuggestionsBox');
            const q = query.trim().toLowerCase();
            const brand = generatorState.selectedBrand;
            
            if (!brand || !modelsByBrand[brand]) return;
            const models = modelsByBrand[brand];

            if (q.length === 0) {
                renderModelDropdown(models);
                return;
            }

            const filtered = models.filter(m => m.toLowerCase().includes(q));
            if (filtered.length === 0) {
                box.innerHTML = `<div class="p-3 text-xs text-slate-400 text-center">Modelo exacto no encontrado. Se usará: "${query}"</div>`;
                box.classList.remove('hidden');
                generatorState.selectedModel = query;
                generatorState.selectedDevice = `${brand} ${query}`;
                document.getElementById('selectedDeviceLabel').innerText = generatorState.selectedDevice;
                document.getElementById('nextStep1Btn').classList.remove('opacity-50', 'pointer-events-none');
                return;
            }

            renderModelDropdown(filtered);
        }

        function renderModelDropdown(list) {
            const box = document.getElementById('modelSuggestionsBox');
            box.innerHTML = list.map(m => `
